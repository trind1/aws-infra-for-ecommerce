#!/bin/bash
set -euo pipefail

umask 077

# Amazon Linux 2023 may already have curl-minimal. Allow DNF to replace a
# conflicting package while installing Docker so the bootstrap transaction
# does not abort before Docker is installed.
dnf install -y --allowerasing docker
command -v curl >/dev/null 2>&1 || dnf install -y curl-minimal
systemctl enable --now docker

if ! command -v amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then
  dnf install -y amazon-cloudwatch-agent || true
fi

if ! command -v amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then
  curl --fail --silent --show-error --location "https://amazoncloudwatch-agent.s3.amazonaws.com/amazon_linux/amd64/latest/amazon-cloudwatch-agent.rpm" --output /tmp/amazon-cloudwatch-agent.rpm
  rpm -U /tmp/amazon-cloudwatch-agent.rpm
fi

install -d -m 0700 /etc/nodejs-api

cat > /etc/nodejs-api.env <<'API_ENV'
# Terraform environment (for example, "dev") identifies the infrastructure.
# The API runs as a production Node.js process on the EC2/ALB deployment.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=${app_port}
DATABASE_URL=${api_database_url}
SESSION_HMAC_SECRET=${api_session_hmac_secret}
CORS_ORIGIN=${api_cors_origin}
DATABASE_CONNECTION_LIMIT=${database_connection_limit}
DATABASE_POOL_TIMEOUT_SECONDS=${database_pool_timeout_seconds}
API_ENV
chmod 600 /etc/nodejs-api.env

docker pull "${docker_image}"
docker rm -f nodejs-api >/dev/null 2>&1 || true

# The awslogs driver sends container stdout/stderr directly to the Terraform-managed
# CloudWatch log group. CloudWatch Agent handles only host system logs and metrics.
docker run --detach \
  --name nodejs-api \
  --restart unless-stopped \
  --publish ${app_port}:${app_port} \
  --env-file /etc/nodejs-api.env \
  --log-driver awslogs \
  --log-opt "awslogs-region=${aws_region}" \
  --log-opt "awslogs-group=${api_log_group_name}" \
  --log-opt "awslogs-stream=${app_name}/$(hostname)" \
  --log-opt awslogs-create-group=false \
  "${docker_image}"

cat > /opt/cloudwatch-agent.json <<'CW_CONFIG'
${cloudwatch_agent_config}
CW_CONFIG
amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/cloudwatch-agent.json -s
